# انسخه إلى .env على الخادم واملأه هناك. لا يُرفع إلى أي مستودع.
# KHUTA_SECRET:  openssl rand -hex 32
# KHUTA_MFA_KEY: openssl rand -base64 32   ← base64 حصرًا، ٣٢ بايت

KHUTA_HOST=khuta.b14facilities.com
TRAEFIK_NETWORK=traefik-proxy
CERT_RESOLVER=letsencrypt

POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# مفتاح توقيع الجلسات وروابط الوسائط
KHUTA_SECRET=
# مفتاح تشفير أسرار المصادقة الثنائية — base64 لـ٣٢ بايت لا غير،
# وفقدانه يُبطل مصادقة كل المستخدمين
KHUTA_MFA_KEY=

KHUTA_DEFAULT_TENANT=alain
